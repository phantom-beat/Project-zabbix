# Copia este archivo como .env (no se sube a GitHub)
#   Copy-Item .env.example .env

# Clave de Artillery Cloud: app.artillery.io -> Settings -> API keys
# (la misma que aparece en "artillery run test.yml --record --key ...")
ARTILLERY_CLOUD_API_KEY=

# Usuario de la API de Zabbix (los mismos de servidor/.env)
ZBX_USER=Admin
ZBX_PASSWORD=zabbix
