# ===== VM zbx-server (192.168.60.10) =====
# Version de las imagenes oficiales de Zabbix (rama 6.4)
ZABBIX_TAG=alpine-6.4-latest

# Base de datos de Zabbix (PostgreSQL)
# OJO: si cambias POSTGRES_PASSWORD cambia tambien DBPassword en config/zabbix_server.conf
POSTGRES_USER=zabbix
POSTGRES_PASSWORD=zabbix_st_2026
POSTGRES_DB=zabbix

# Puertos publicados en la VM
ZBX_WEB_PORT=8080
ZBX_SERVER_PORT=10051
MAILHOG_SMTP_PORT=1025
MAILHOG_WEB_PORT=8025

# Credenciales de la API (usuario por defecto de Zabbix)
ZBX_API_USER=Admin
ZBX_API_PASSWORD=zabbix

# Datos que usa el script de configuracion automatica
ZBX_PROXY_NAME=proxy-servicios
MYSQL_MONITOR_USER=zbx_monitor
MYSQL_MONITOR_PASSWORD=Monitor_2026

# Correo de destino de las alertas y cuenta SMTP real: ver .env.smtp.example

TZ=America/Bogota
