# Copiar como .env.smtp y completar (Copy-Item .env.smtp.example .env.smtp)
# Correo de alertas y cuenta SMTP real (opcional). NO se sube a GitHub (.gitignore).
# Si este archivo no existe, las alertas van a admin@st.local y solo se ven en MailHog.
#   Gmail:       smtp.gmail.com     587  (requiere "contrasena de aplicacion", no la normal)
#   Outlook/365: smtp.office365.com 587
ALERT_EMAIL=tu_correo@ejemplo.com
SMTP_REAL_SERVER=smtp.gmail.com
SMTP_REAL_PORT=587
SMTP_REAL_USER=
SMTP_REAL_PASSWORD=
