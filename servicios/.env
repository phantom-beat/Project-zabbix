# ===== VM zbx-servicios (192.168.60.20) =====
ZABBIX_TAG=alpine-6.4-latest

# IP de la VM y del servidor Zabbix (red privada de Vagrant)
VM_IP=192.168.60.20
ZBX_SERVER_IP=192.168.60.10
ZBX_PROXY_NAME=proxy-servicios

# Red Docker interna (IPs fijas: el servidor Zabbix las usa como interfaz de cada host)
