PROXY_IP=172.30.0.2
WEB_IP=172.30.0.11
DB_IP=172.30.0.12
DNS_IP=172.30.0.13
FTP_IP=172.30.0.14

# Web
WEB_PORT=80

# MySQL
MYSQL_ROOT_PASSWORD=Root_st_2026
MYSQL_DATABASE=servicios
MYSQL_APP_USER=app
MYSQL_APP_PASSWORD=App_2026
# Usuario de solo lectura para el template "MySQL by Zabbix agent 2"
MYSQL_MONITOR_USER=zbx_monitor
MYSQL_MONITOR_PASSWORD=Monitor_2026

# FTP
FTP_USER=ftpuser
FTP_PASS=Ftp_2026

TZ=America/Bogota
